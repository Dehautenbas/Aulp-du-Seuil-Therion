encoding  utf-8

survey reseau_de_la_cascade -title "Guiers Vif > Réseau de la Cascade"

    input Data/10-07-2022_reseau_de_la_cascade/10_07_2022_GV_Cascade.th
    input Data/12-03-2022_reseau_de_la_cascade/12_03_2022_GV_Cascade.th
    input Data/16-12-2023_reseau_de_la_cascade/16-12-2023_GV_Cascade.th
    input Data/05-01-2024_reseau_de_la_cascade/05-01-2024_GV_Cascade.th
    
    #***********************************************************************
    # Pour ajouter le cheminement de calage de la seance du 12-03-2022
    # ce qui permet d'avoir un point de référence solide :
    # bloc dans les marches d'escalier d'accès du Guiers Vif.
    #***********************************************************************
    
      input Data/12-03-2022_reseau_de_la_cascade_calage/12_03_2022_GV_Cascade-calage.th
      
      equate dp_stat_37@gv_12-03-2022_reseau_de_la_cascade.12_03_2022_GV_Cascade dp_stat_37@gv_12-03-2022_reseau_de_la_cascade-calage.12_03_2022_GV_Cascade-calage
      
    #***********
    
    equate dp_stat_@gv_2022-07-09_cascade.10_07_2022_GV_Cascade dp_stat_1@gv_12-03-2022_reseau_de_la_cascade.12_03_2022_GV_Cascade
    equate dp_stat_46@gv_2022-07-09_cascade.10_07_2022_GV_Cascade 0@gv_16-12-2023_reseau_de_la_cascade.16_12_2023_GV_Cascade
    equate 38@gv_16-12-2023_reseau_de_la_cascade.16_12_2023_GV_Cascade 0@gv_05-01-2024_reseau_de_la_cascade.05_01_2024_GV_Cascade

    ## Plan
   
    join scrap1@16_12_2023_GV_Cascade scrap5@10_07_2022_GV_Cascade
    
    ## Coupe
 
      join sc1@05_01_2024_GV_Cascade sc1@16_12_2023_GV_Cascade
      join sc1@16_12_2023_GV_Cascade sc1@10_07_2022_GV_Cascade
      join sc1@10_07_2022_GV_Cascade sc1@12_03_2022_GV_Cascade

    ## Maps
    input gv_reseau_de_la_cascade-tot-maps.th

endsurvey

