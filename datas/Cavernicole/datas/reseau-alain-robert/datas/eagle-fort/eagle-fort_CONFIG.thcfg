encoding  utf-8
input ../../config2.thcfg
input ../../../layouts/config3.thcfg
source eagle-fort_tot.th

###################################################################################################
################################## Selection de la map à exporter #################################
###################################################################################################
select MP_eagle-fort@eagle-fort_tot       #uncomment ONLY one
#select MC_eagle-fort@eagle-fort_tot      #uncomment ONLY one




######################## PDF ########################
export map \
     -projection plan \
     -layout plan \
     -output exports/eagle-fort_plan.pdf \

#export map \
     -projection extended \
     -layout coupe \
     -output exports/eagle-fort_coupe.pdf \


######################## STATIONS ########################
# l'ordre des layouts est importants !

export map \
     -projection plan \
     -layout plan \
     -layout centerline \
     -output exports/eagle-fort_plan-travail.pdf \

#export map \
     -projection extended \
     -layout coupe \
     -layout centerline \
     -output exports/eagle-fort_coupe-travail.pdf \


######################### DEBUG ########################
#export map \
     -projection plan \
     -layout plan   \
     -layout-debug all \
     -output exports/eagle-fort_DEBUG_plan.pdf

#export map \
     -projection extended \
     -layout coupe   \
     -layout-debug all \
     -output exports/eagle-fort_DEBUG_coupe.pdf

     
######################### SVG ########################

#export map \
     -projection plan \
     -fmt svg   \
     -layout plan   \
     -output exports/eagle-fort_plan.svg \

#export map \
     -projection extended \
     -layout plan   \
     -output exports/eagle-fort_coupe.svg \

#export model \
     -output exports/eagle-fort_coupe.dxf \



