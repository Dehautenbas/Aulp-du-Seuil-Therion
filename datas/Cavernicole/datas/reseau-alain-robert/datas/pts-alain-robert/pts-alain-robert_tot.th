encoding  utf-8

survey pts-alain-robert_tot -title "Cavernicole > Alain Robert > Pts Alain-robert"

    input pts-alain-robert_maps.th
    input datas/alain-robert.th
    input datas/sommet-pts-robert.th
        equate 0@sommet-pts-robert PTRX@alain-robert

    ## Plan
    input datas/alain-robert_2_p.th2
    input datas/alain-robert_p.th2
         join alain-robert_sp2 alain-robert_2_sp1
    
    ## Coupe
    input datas/alain-robert_c.th2

    

endsurvey

